# Игнорируем node_modules
node_modules

# Игнорируем скрытые файлы и папки
.*
!.gitignore

# Игнорируем логи
npm-debug.log
yarn-debug.log
yarn-error.log

# Игнорируем временные файлы
.temp
.tmp

# Игнорируем IDE файлы
.idea
.vscode
*.sublime-*

# Игнорируем файлы окружения, кроме .env.production
.env*
!.env.production

# Игнорируем собранные файлы
/dist
/build

# Игнорируем базы данных
*.db
*.sqlite
*.sqlite3

# Игнорируем загруженные файлы
/uploads

# Игнорируем кэш
.cache
.parcel-cache
.vite

# Игнорируем тесты
__tests__
*.test.js
*.spec.js

# Утилиты разработчика: в образе им делать нечего. Каждая из них — готовый инструмент эскалации
# для того, кто получил доступ к контейнеру (создать админа, удалить пользователя, выгрузить
# список аккаунтов). Локально они работают как раньше — исключение действует только для сборки.
server/create_admin.js
server/delete_user.js
server/list_users.js
server/check_dbs.js
server/check_index.js
