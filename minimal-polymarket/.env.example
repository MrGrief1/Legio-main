# Required in production. Use a long random value.
JWT_SECRET="change-me-to-a-long-random-secret"

# Required on Railway/production. Railway Postgres can expose this to the app service.
# Locally you can leave it empty; the server will use server/data/db.json.
DATABASE_URL=""

# Optional local/temporary escape hatch. Do not enable this on Railway if you need data to persist.
ALLOW_JSON_STORAGE="false"

# Set to true only if your Postgres provider requires SSL.
DATABASE_SSL="false"

# Railway injects PORT automatically. Local default is 3000.
PORT="3000"
