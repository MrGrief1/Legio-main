# Required in production. Use a long random value.
JWT_SECRET="change-me-to-a-long-random-secret"

# Railway Postgres will provide this automatically if you add a Postgres service.
# Locally you can leave it empty; the server will use server/data/db.json.
DATABASE_URL=""

# Set to true only if your Postgres provider requires SSL.
DATABASE_SSL="false"

# Railway injects PORT automatically. Local default is 3000.
PORT="3000"
