# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=""

# Required to create or rotate the first admin account.
# The app no longer gives admin rights to the first public registration.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="Legio Admin"

# Recommended in production, for strict CSRF origin checks.
APP_ORIGIN="https://your-domain.example"

# Required on Railway/production. Railway Postgres can expose this to the app service.
# Locally you can leave it empty; the server will use server/data/db.json.
DATABASE_URL=""

# Optional local/temporary escape hatch. Do not enable this on Railway if you need data to persist.
ALLOW_JSON_STORAGE="false"

# Set to true only if your Postgres provider requires SSL.
DATABASE_SSL="false"

# Railway injects PORT automatically. Local default is 3000.
PORT="3000"

# Optional. Railway sets this automatically when a Volume is attached.
# Use LEGIO_DATA_DIR only when you want to override where JSON storage is written.
LEGIO_DATA_DIR=""

# Keep false unless you have a separate trusted API client that cannot use cookies.
ALLOW_BEARER_TOKENS="false"
