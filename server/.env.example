# Server Environment Variables
# Copy this to .env and fill in the values

# Server Configuration
PORT=3001
HOST=0.0.0.0

# Optional custom path to the SQLite database file.
# When empty, the app uses /app/data/database.sqlite on Railway
# or server/database.sqlite locally.
DATABASE_PATH=

# Where uploaded avatars and attachments are stored.
# Leave empty: the app then puts them next to the database, i.e. ON THE PERSISTENT VOLUME.
# This matters — anything stored outside the volume (the old <app>/uploads default) is wiped on
# every deploy, while the database keeps pointing at the missing file.
UPLOADS_DIR=

# Flat reward credited to the winner of each monthly event, once the month closes.
# The monthly scores only decide who wins; this is what they actually receive.
MONTHLY_PRIZE_POINTS=5000

# Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Rotating this value invalidates every issued session (everyone signs in again) — which is
# exactly what you want if you ever suspect the key leaked.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
# Optional legacy alias if your platform already uses this name:
# JWT_SECRET=replace-with-the-same-random-secret

# How long a login stays valid. Accepts zeit/ms syntax: 30m, 12h, 7d.
# Смена и сброс пароля отзывают все ранее выданные токены (users.token_version), поэтому окно
# здесь ограничивает не «навсегда», а лишь срок жизни украденного токена, о краже которого никто
# не узнал. Уменьшайте с оглядкой на второй фактор: при включённом входе по коду каждое повторное
# логинирование — это ещё одно письмо.
JWT_EXPIRES_IN=7d

# bcrypt work factor for password hashing. Higher = slower to crack a stolen table, and slower to
# log in. 12 is a good default; do not go below 10.
BCRYPT_ROUNDS=12

# Maximum accepted JSON request body. No route needs more than a few kilobytes; a large limit is a
# cheap denial-of-service lever. File uploads are multipart and capped separately at 5 MB.
JSON_BODY_LIMIT=256kb

# Bootstrap admin creation is disabled in production by default.
# Set to true only for the very first trusted registration.
ALLOW_BOOTSTRAP_ADMIN=false

# Единственный способ получить админа из окружения. При старте (и после полной WordPress-
# синхронизации, которая пересоздаёт таблицу пользователей) аккаунт с этим логином создаётся,
# если его нет, и получает роль admin. INITIAL_ADMIN_PASSWORD задаёт пароль только когда текущий
# не совпадает — уберите его из окружения после первого входа, иначе каждый деплой возвращает
# пароль из переменной.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional salt for visit deduplication. Defaults to SECRET_KEY when empty.
VISITOR_ID_HASH_SALT=

# CORS Configuration
# Which OTHER origins may call this API from a browser. The bundled frontend is served by this
# same process, so it is same-origin and needs no entry here — leave this empty unless a separate
# site must reach the API.
# Empty + NODE_ENV=production  -> cross-origin browser requests are refused (the safe default).
# Empty + development          -> any origin is allowed, for convenience.
# Example: ALLOWED_ORIGINS=https://legio.news,https://www.legio.news
ALLOWED_ORIGINS=

# CSP Connect Origins (optional)  
# Leave empty for default localhost
# Set in production: CSP_CONNECT_ORIGINS='self' https://your-frontend.railway.app
CSP_CONNECT_ORIGINS=

# Frontend URL (for reference)
FRONTEND_URL=http://localhost:3000

# Optional public backend URL used for absolute upload links.
# Leave empty to return relative /uploads/... paths.
PUBLIC_BASE_URL=

# --- Письма с одноразовыми кодами (регистрация, вход по коду, сброс и смена пароля/почты) ---
# Без ключа письма не уходят. В production это означает, что регистрация и второй фактор не
# работают; в разработке коды печатаются в лог сервера.
RESEND_API_KEY=
# Адрес отправителя. Домен должен быть подтверждён в Resend, иначе письма не доставляются.
RESEND_FROM=Legio <noreply@legio.news>

# Печатать код в лог вместо письма, когда RESEND_API_KEY не задан. Вне production включено само,
# в production требует явного true. Не включайте на боевом сервере: код в логах — это код,
# доступный всем, у кого есть логи.
ALLOW_UNSENT_CODES=false

# --- Ограничение частоты запросов (все значения опциональны) ---
# Общий потолок на /api/ за 15 минут.
RATE_LIMIT_MAX=600
# Неудачные попытки входа за 15 минут (успешные не считаются).
LOGIN_RATE_LIMIT_MAX=10
# Запросы, отправляющие письмо с кодом, за час. Ввод кода в этот счётчик не попадает.
EMAIL_CODE_RATE_LIMIT_MAX=30

# Legacy WordPress / MySQL sync (optional)
# Set these when migrating old legio.news data into this project.
WP_DB_HOST=
WP_DB_PORT=3306
WP_DB_USER=
WP_DB_PASSWORD=
WP_DB_NAME=
WP_DB_PREFIX=wp_

# Run sync automatically when backend starts
WP_SYNC_ON_STARTUP=false

# true: fully replace local SQLite content with legacy WordPress data
# false: keep existing data and upsert where possible
WP_SYNC_FULL_REPLACE=true
